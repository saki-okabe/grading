# ===== 必須 =====
# VLMのAPIエンドポイント・キー・モデル名（画像を読めるVLMを指定すること）
API_BASE_URL=http://localhost:1234/v1
API_KEY=lm-studio
MODEL_NAME=<使用するモデル名>

# ===== 任意（省略時はコメントの既定値を使用） =====
# 提出物のルートフォルダ
SUBMITTED_DIR=./Submitted files

# 学生名簿CSV（1列目: ローマ字氏名, 2列目: 漢字氏名）
# STUDENT_LIST_PATH=./student_list.csv

# 全体集計CSVの出力先
# SUMMARY_DIR=./grading_summary

# 再採点やキャリブレーション時に、集計を既存と分けたいときは専用フォルダに向ける
# SUMMARY_DIR=./regrade_summaries

# 採点対象と実行モード（省略時は grader.py の既存定数を使用）
# TARGET_ASSIGNMENT=リフレクションシート7
# GRADE_ALL_ASSIGNMENTS=false
# SKIP_ALREADY_GRADED=false
# SUMMARY_REGRADED_ONLY=false
# GRADE_LIMIT=3
# GRADE_LIMIT=none で上限なし（既定）
